# ==============================================================================
# AI Administrative Co-Pilot (Revenue Recovery & Smart Petition OCR) - .gitignore
# ==============================================================================

# Node / Frontend
node_modules/
Frontend/node_modules/
Frontend/dist/
Frontend/dist-ssr/
Frontend/legacy_backup/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python / Backend
__pycache__/
Backend/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
Backend/.venv/
env/
ENV/
env.bak/
venv.bak/

# Uploads & Generated Outputs
Backend/uploads/*
!Backend/uploads/.gitkeep
Backend/outputs/*
!Backend/outputs/.gitkeep
Backend/output/*
!Backend/output/.gitkeep
output/
outputs/
temp/
tmp/
*.tmp

# Heavy ONNX / Tar Models (Keep dictionary & gitkeep)
Backend/models/*.onnx
Backend/models/*.tar
Backend/models/ta_PP-OCRv4_rec_infer/
!Backend/models/ta_dict.txt
!Backend/models/.gitkeep

# IDEs & System Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.gemini/
.agent/

# Environment Variables & Secrets
.env
.env.*
!.env.example
