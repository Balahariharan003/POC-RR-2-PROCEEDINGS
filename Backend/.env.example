# ==============================================================================
# TAMIL NADU REVENUE RECOVERY PROCEEDINGS AUTOMATION SYSTEM (PRODUCTION ENV)
# ==============================================================================

# Core Application Settings
APP_NAME=TN-RR-Proceedings-API
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
SECRET_KEY=generate-a-secure-random-64-char-hex-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cryptographic Security - Advanced Hybrid HMAC-SHA256 Anti-Brute-Force Pepper
CRYPTO_PEPPER=TN-GOV-RR-SECURE-PEPPER-2026-v2-HYBRID-ANTI-BRUTE-FORCE

# PostgreSQL Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_secure_db_password
PG_DATABASE=rr_proceedings_db
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_db_password@localhost:5432/rr_proceedings_db

# Datalab Chandra OCR API Configuration (No RapidOCR)
OCR_VERSION=Chandra-v2
CHANDRA_OCR_URL=https://api.datalab.to/v1/ocr
CHANDRA_PRIMARY_MODE=accurate
CHANDRA_FALLBACK_MODE=balance
DATALAB_API_KEY=your_datalab_api_key_here
CHANDRA_TIMEOUT_SECONDS=45

# Ollama LLM Settings (qwen2.5:3b-instruct)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_FALLBACK_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_CONNECT_TIMEOUT_SECONDS=10.0
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2048

# Typography Settings - TAU-Marutham Font Alone
PRIMARY_FONT_TAMIL=TAU-Marutham
FALLBACK_FONT_TAMIL=TAU-Marutham
LATIN_FONT=TAU-Marutham

# Storage Paths
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
TEMPLATE_DIR=templates
